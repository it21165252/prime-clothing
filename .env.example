# Prime Clothing environment variables
# Copy to .env.local and fill in once a dedicated Prime Clothing Supabase project exists.
# Do NOT reuse the Prime Racing project or keys.
# While these are empty the site runs on the built-in localStorage mock (demo auth + orders).

VITE_SUPABASE_URL=https://your-prime-clothing-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Free island-wide delivery threshold in LKR (optional, defaults to 15000)
VITE_FREE_DELIVERY_THRESHOLD=15000
